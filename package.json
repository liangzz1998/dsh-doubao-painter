{
  "name": "dsh-doubao-painter",
  "version": "0.5.0",
  "description": "把本机豆包桌面客户端的生图能力接进 DeepSeek Harness：agent 一句 doubao_paint 就能让豆包出图，并直接拿到无水印高清原图。基于 CDP 驱动，不需要逆向接口、不需要额外 API Key、不产生去水印成本。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "doubao",
    "豆包",
    "text-to-image",
    "image-generation",
    "seedream",
    "cdp"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./bridge": "./lib/bridge.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "paint": "node tools/paint.mjs",
    "test": "node --test tests/plugin.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
